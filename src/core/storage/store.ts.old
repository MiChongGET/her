// Task 2.2: Her-Pi v1 storage layer.
// This is a clean-slate rewrite for the new Pi runtime. All old tables are dropped.
// Old ChatService will break until stage 4 replaces it (user confirmed approach 2).

import { createHash, randomUUID } from 'node:crypto'
import { mkdirSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { DatabaseSync } from 'node:sqlite'
import type {
  ProviderProtocol, ServiceModel, TestKind, ConnectionTestResult,
  McpServiceConfig, FileGrant, DesktopSettings
} from '../../shared/types'

// ──────────────────────────────────────────────────────────────────────────────
// Service and credential types (replaces old profiles)
// ──────────────────────────────────────────────────────────────────────────────

export interface StoredService {
  id: string
  name: string
  protocol: ProviderProtocol
  baseUrl: string
  defaultModel: string
  sealedSecrets: string | null
  hasApiKey: boolean
  hasCustomHeaders: boolean
  maxOutputTokens: number | null
  models: ServiceModel[]
  revision: number
  tests: Record<TestKind, ConnectionTestResult>
}

// ──────────────────────────────────────────────────────────────────────────────
// Conversation and session authority types
// ──────────────────────────────────────────────────────────────────────────────

export interface StoredConversation {
  id: string
  title: string
  titleCustom: boolean
  createdAt: Date
  updatedAt: Date
  deletedAt: Date | null
  /** Pi session ID (the session file basename without .jsonl) */
  piSessionId: string
  /** Last known entry ID from Pi, used for projection version tracking */
  lastEntryId: string | null
}

// ──────────────────────────────────────────────────────────────────────────────
// Input queue and task types
// ──────────────────────────────────────────────────────────────────────────────

export type InputQueueStatus = 'pending' | 'running' | 'cancelled' | 'completed'

export interface StoredInputRequest {
  id: string
  conversationId: string
  content: string
  /** JSON array of attachment references */
  attachments: string | null
  status: InputQueueStatus
  createdAt: Date
  startedAt: Date | null
  completedAt: Date | null
}

export type TaskStatus =
  | 'queued'
  | 'running'
  | 'waiting_approval'
  | 'waiting_resource'
  | 'compacting'
  | 'retrying'
  | 'stopping'
  | 'completed'
  | 'stopped'
  | 'failed'
  | 'interrupted'

export interface StoredTask {
  id: string
  conversationId: string
  requestId: string
  generation: number
  status: TaskStatus
  serviceId: string
  modelId: string
  configRevision: number
  createdAt: Date
  startedAt: Date | null
  endedAt: Date | null
  error: string | null
}

// ──────────────────────────────────────────────────────────────────────────────
// Tool execution and action ledger types
// ──────────────────────────────────────────────────────────────────────────────

export type ToolCallStatus =
  | 'pending'
  | 'awaiting_approval'
  | 'running'
  | 'succeeded'
  | 'failed'
  | 'cancelled'
  | 'unknown'

export type DispatchPhase =
  | 'validation'
  | 'authorization'
  | 'resource_wait'
  | 'dispatched'
  | 'completed'

export interface StoredToolCall {
  id: string
  taskId: string
  callId: string
  toolName: string
  /** JSON serialized arguments */
  arguments: string
  status: ToolCallStatus
  dispatchPhase: DispatchPhase
  result: string | null
  error: string | null
  createdAt: Date
  dispatchedAt: Date | null
  completedAt: Date | null
}

// ──────────────────────────────────────────────────────────────────────────────
// Projection and display types
// ──────────────────────────────────────────────────────────────────────────────

export interface StoredProjectionEntry {
  conversationId: string
  entryId: string
  /** JSON serialized ProjectedSessionEntry */
  content: string
  sequenceNumber: number
}

export interface StoredDraftFragment {
  taskId: string
  fragmentType: 'text' | 'tool_call'
  content: string
  createdAt: Date
}

// ──────────────────────────────────────────────────────────────────────────────
// MCP, file grants, and settings types
// ──────────────────────────────────────────────────────────────────────────────

export interface StoredMcpService {
  id: string
  revision: number
  config: McpServiceConfig
  sealedSecrets: string | null
}

export interface StoredFileGrant {
  id: string
  conversationId: string | null
  path: string
  scope: 'conversation' | 'persistent'
  grantedAt: Date
  revokedAt: Date | null
  revision: number
}

// ──────────────────────────────────────────────────────────────────────────────
// Database class
// ──────────────────────────────────────────────────────────────────────────────

export function untestedConnections(): Record<TestKind, ConnectionTestResult> {
  return {
    chat: { status: 'untested', message: '尚未测试' },
    tools: { status: 'untested', message: '尚未测试' },
    vision: { status: 'untested', message: '尚未测试' }
  }
}

export class HerStore {
  private readonly db: DatabaseSync
  readonly artifactDirectory: string
  readonly documentDirectory: string

  constructor(path: string) {
    this.documentDirectory = path === ':memory:' ? '' : join(dirname(path), 'documents')
    this.artifactDirectory = path === ':memory:' ? '' : join(dirname(path), 'tool-artifacts')
    if (path !== ':memory:') mkdirSync(dirname(path), { recursive: true, mode: 0o700 })
    this.db = new DatabaseSync(path)
    this.db.exec('PRAGMA foreign_keys = ON; PRAGMA journal_mode = WAL;')
    const version = this.db.prepare('PRAGMA user_version').get() as { user_version: number }
    if (version.user_version > 12) {
      this.db.close()
      throw new Error('本地资料版本比当前应用新，请使用较新版本的 Her。')
    }
    this.db.exec(`
      CREATE TABLE IF NOT EXISTS profiles (
        id TEXT PRIMARY KEY, name TEXT NOT NULL, protocol TEXT NOT NULL,
        base_url TEXT NOT NULL, model TEXT NOT NULL, sealed_secrets TEXT,
        has_api_key INTEGER NOT NULL, has_custom_headers INTEGER NOT NULL,
        tests TEXT NOT NULL, revision INTEGER NOT NULL, max_output_tokens INTEGER, models TEXT
      );
      CREATE TABLE IF NOT EXISTS settings (id INTEGER PRIMARY KEY CHECK (id = 1), value TEXT NOT NULL);
      CREATE TABLE IF NOT EXISTS conversations (
        id TEXT PRIMARY KEY, title TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
        title_custom INTEGER NOT NULL DEFAULT 0, deleted_at TEXT
      );
      CREATE TABLE IF NOT EXISTS messages (
        id TEXT PRIMARY KEY,
        conversation_id TEXT NOT NULL REFERENCES conversations(id),
        role TEXT NOT NULL CHECK (role IN ('user', 'assistant')),
        content TEXT NOT NULL,
        status TEXT NOT NULL CHECK (status IN ('complete', 'streaming', 'failed', 'cancelled')),
        created_at TEXT NOT NULL, profile_id TEXT, model TEXT, error TEXT, attachments TEXT, tool_calls TEXT
      );
      CREATE INDEX IF NOT EXISTS messages_by_conversation ON messages(conversation_id);
    `)
    this.db.exec('BEGIN IMMEDIATE')
    try {
      const columns = this.db.prepare('PRAGMA table_info(profiles)').all() as unknown as { name: string }[]
      if (!columns.some(column => column.name === 'max_output_tokens')) {
        this.db.exec('ALTER TABLE profiles ADD COLUMN max_output_tokens INTEGER')
      }
      const conversationColumns = this.db.prepare('PRAGMA table_info(conversations)').all() as unknown as { name: string }[]
      if (!conversationColumns.some(column => column.name === 'title_custom')) {
        this.db.exec('ALTER TABLE conversations ADD COLUMN title_custom INTEGER NOT NULL DEFAULT 0')
      }
      if (!conversationColumns.some(column => column.name === 'deleted_at')) {
        this.db.exec('ALTER TABLE conversations ADD COLUMN deleted_at TEXT')
      }
      if (!columns.some(column => column.name === 'models')) {
        this.db.exec('ALTER TABLE profiles ADD COLUMN models TEXT')
      }
      const messageColumns = this.db.prepare('PRAGMA table_info(messages)').all() as unknown as { name: string }[]
      if (!messageColumns.some(column => column.name === 'attachments')) {
        this.db.exec('ALTER TABLE messages ADD COLUMN attachments TEXT')
      }
      if (!messageColumns.some(column => column.name === 'tool_calls')) {
        this.db.exec('ALTER TABLE messages ADD COLUMN tool_calls TEXT')
      }
      const legacy = this.db.prepare('SELECT id, model, tests FROM profiles WHERE models IS NULL')
        .all() as unknown as { id: string; model: string; tests: string }[]
      for (const row of legacy) {
        const models: ServiceModel[] = [{ id: row.model, longOutput: false, multimodal: false, tests: JSON.parse(row.tests) }]
        this.db.prepare('UPDATE profiles SET models = ? WHERE id = ?').run(JSON.stringify(models), row.id)
      }
      this.db.exec(`
        CREATE TABLE IF NOT EXISTS task_runs (
          id TEXT PRIMARY KEY, request_id TEXT NOT NULL,
          conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
          assistant_message_id TEXT NOT NULL, status TEXT NOT NULL,
          provider_id TEXT NOT NULL, model TEXT NOT NULL,
          tool_calls_count INTEGER NOT NULL, active_ms INTEGER NOT NULL
        );
        CREATE TABLE IF NOT EXISTS tool_executions (
          run_id TEXT NOT NULL REFERENCES task_runs(id) ON DELETE CASCADE,
          id TEXT NOT NULL, name TEXT NOT NULL, arguments TEXT NOT NULL,
          result TEXT, status TEXT NOT NULL, started_at TEXT, finished_at TEXT,
          PRIMARY KEY (run_id, id)
        );
        CREATE TABLE IF NOT EXISTS tool_artifacts (
          id TEXT PRIMARY KEY,
          conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
          mime_type TEXT NOT NULL, byte_length INTEGER NOT NULL, source_file_id TEXT
        );
        UPDATE task_runs SET status = 'stopped' WHERE status IN ('running', 'awaiting_confirmation', 'paused');
        UPDATE tool_executions SET status = 'unknown' WHERE status = 'running';
        UPDATE tool_executions SET status = 'cancelled' WHERE status IN ('pending', 'awaiting_confirmation');
        PRAGMA user_version = 5;
      `)
      if (version.user_version < 6) {
        this.db.exec(`
          ALTER TABLE task_runs ADD COLUMN continuation_of TEXT;
          ALTER TABLE task_runs ADD COLUMN tool_revisions TEXT;
          ALTER TABLE tool_executions ADD COLUMN assessment TEXT;
        `)
      }
      this.db.exec('PRAGMA user_version = 6')
      if (version.user_version < 7) {
        this.db.exec(`
          CREATE TABLE mcp_services (
            id TEXT PRIMARY KEY, revision INTEGER NOT NULL,
            config TEXT, sealed_secrets TEXT, test_result TEXT
          );
        `)
      }
      if (version.user_version < 8) this.db.exec(`
        ALTER TABLE tool_executions ADD COLUMN dispatch_phase TEXT;
        CREATE TABLE tool_resolutions (
          run_id TEXT NOT NULL, call_id TEXT NOT NULL, revision TEXT NOT NULL,
          decision TEXT NOT NULL, resolved_at TEXT NOT NULL,
          PRIMARY KEY (run_id, call_id),
          FOREIGN KEY (run_id, call_id) REFERENCES tool_executions(run_id, id) ON DELETE CASCADE
        );
      `)
      if (version.user_version < 9) this.db.exec(`
        ALTER TABLE messages ADD COLUMN files TEXT;
        ALTER TABLE messages ADD COLUMN file_sources TEXT;
        CREATE TABLE file_grants (
          id TEXT PRIMARY KEY, conversation_id TEXT REFERENCES conversations(id) ON DELETE CASCADE,
          data TEXT NOT NULL
        );
        CREATE TABLE file_references (
          id TEXT PRIMARY KEY, conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
          grant_id TEXT NOT NULL REFERENCES file_grants(id) ON DELETE CASCADE,
          data TEXT NOT NULL
        );
      `)
      if (version.user_version < 10) this.db.exec(`
        CREATE TABLE documents (
          id TEXT PRIMARY KEY, conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
          file_id TEXT NOT NULL REFERENCES file_references(id) ON DELETE CASCADE,
          cache_key TEXT NOT NULL, data TEXT NOT NULL
        );
      `)
      if (version.user_version < 11) this.db.exec(`
        CREATE TABLE document_owners (
          id TEXT PRIMARY KEY, conversation_id TEXT NOT NULL, published INTEGER NOT NULL DEFAULT 0
        );
        INSERT INTO document_owners(id, conversation_id, published) SELECT id, conversation_id, 1 FROM documents;
      `)
      if (version.user_version < 12) this.db.exec(`
        CREATE TABLE artifact_owners (
          id TEXT PRIMARY KEY, conversation_id TEXT NOT NULL, published INTEGER NOT NULL DEFAULT 0
        );
        INSERT INTO artifact_owners(id, conversation_id, published) SELECT id, conversation_id, 1 FROM tool_artifacts;
      `)
      this.db.exec('PRAGMA user_version = 12')
      this.db.exec('COMMIT')
    } catch (error) {
      this.db.exec('ROLLBACK')
      this.db.close()
      throw error
    }
    this.recoverDocumentFiles()
    this.recoverArtifactFiles()
    this.db.prepare("UPDATE messages SET status = 'cancelled', error = ? WHERE status = 'streaming'")
      .run('上次应用退出时，回答尚未完成。')
  }

  close(): void { this.db.close() }

  saveFileGrant(value: StoredFileGrant): void {
    this.db.prepare('INSERT INTO file_grants(id, conversation_id, data) VALUES (?, ?, ?) ON CONFLICT(id) DO UPDATE SET data = excluded.data')
      .run(value.grant.id, value.grant.conversationId ?? null, JSON.stringify(value))
  }

  getFileGrant(id: string): StoredFileGrant | null {
    const row = this.db.prepare('SELECT data FROM file_grants WHERE id = ?').get(id) as { data: string } | undefined
    return row ? JSON.parse(row.data) : null
  }

  listFileGrants(): StoredFileGrant[] {
    return (this.db.prepare('SELECT data FROM file_grants ORDER BY rowid').all() as { data: string }[]).map(row => JSON.parse(row.data))
  }

  saveFileReference(value: StoredFileReference): void {
    this.db.prepare('INSERT INTO file_references(id, conversation_id, grant_id, data) VALUES (?, ?, ?, ?)')
      .run(value.reference.id, value.conversationId, value.reference.grantId, JSON.stringify(value))
  }

  getFileReference(id: string): StoredFileReference | null {
    const row = this.db.prepare('SELECT data FROM file_references WHERE id = ?').get(id) as { data: string } | undefined
    return row ? JSON.parse(row.data) : null
  }

  beginDocumentFiles(id: string, conversationId: string): void {
    if (!/^[a-f0-9-]{36}$/.test(id) || !this.hasConversation(conversationId)) throw new Error('文档所属对话已失效。')
    this.db.prepare('INSERT INTO document_owners(id, conversation_id) VALUES (?, ?)').run(id, conversationId)
  }
  listDocumentOwners(conversationId: string): { id: string; published: number }[] {
    return this.db.prepare('SELECT id, published FROM document_owners WHERE conversation_id = ?').all(conversationId) as { id: string; published: number }[]
  }
  forgetDocumentFiles(id: string): void { this.db.prepare('DELETE FROM document_owners WHERE id = ?').run(id) }
  private recoverDocumentFiles(): void {
    // One bounded pass over durable unfinished owners. Never scan or delete unknown paths.
    const owners = this.db.prepare('SELECT id FROM document_owners WHERE published = 0 OR conversation_id NOT IN (SELECT id FROM conversations)').all() as { id: string }[]
    for (const owner of owners) {
      try { this.removeDocumentFiles([owner.id]) }
      catch { this.documentCleanupWarning = DOCUMENT_CLEANUP_ERROR }
    }
  }
  saveDocument(value: StoredDocument): void {
    if (!this.db.prepare('SELECT id FROM document_owners WHERE id = ? AND conversation_id = ?').get(value.reference.id, value.conversationId)) throw new Error('文档清理记录已失效。')
    this.db.exec('BEGIN IMMEDIATE')
    try {
      this.db.prepare('INSERT INTO documents(id, conversation_id, file_id, cache_key, data) VALUES (?, ?, ?, ?, ?)')
        .run(value.reference.id, value.conversationId, value.reference.fileId, value.cacheKey, JSON.stringify(value))
      this.db.prepare('UPDATE document_owners SET published = 1 WHERE id = ?').run(value.reference.id)
      this.db.exec('COMMIT')
    } catch (error) { this.db.exec('ROLLBACK'); throw error }
  }
  getDocument(id: string): StoredDocument | null {
    const row = this.db.prepare('SELECT data FROM documents WHERE id = ?').get(id) as { data: string } | undefined
    return row ? JSON.parse(row.data) : null
  }
  findDocument(conversationId: string, cacheKey: string): StoredDocument | null {
    const row = this.db.prepare('SELECT data FROM documents WHERE conversation_id = ? AND cache_key = ? ORDER BY rowid DESC LIMIT 1').get(conversationId, cacheKey) as { data: string } | undefined
    return row ? JSON.parse(row.data) : null
  }
  private documentIds(conversationId: string): string[] {
    return this.listDocumentOwners(conversationId).map(row => row.id)
  }
  private removeDocumentFiles(ids: string[], preserveUnpublished = false): void {
    const cache = new DocumentCache(this.documentDirectory)
    for (const id of ids) {
      cache.removeSync(id)
      // An admitted asynchronous write can finish after purge. Keep its durable
      // unpublished owner until completion or the next startup recovery pass.
      if (!preserveUnpublished || this.db.prepare('SELECT published FROM document_owners WHERE id = ?').get(id)?.published === 1) this.forgetDocumentFiles(id)
    }
  }

  getSettings(): DesktopSettings {
    const row = this.db.prepare('SELECT value FROM settings WHERE id = 1').get() as { value: string } | undefined
    return { activeProfileId: null, shortcut: 'CommandOrControl+Shift+H', stopShortcut: 'CommandOrControl+Shift+Escape', launchAtLogin: false, ...(row ? JSON.parse(row.value) : {}) } as DesktopSettings
  }

  setSettings(settings: DesktopSettings): void {
    this.db.prepare('INSERT INTO settings (id, value) VALUES (1, ?) ON CONFLICT(id) DO UPDATE SET value = excluded.value')
      .run(JSON.stringify(settings))
  }

  listProfiles(): StoredProfile[] {
    return (this.db.prepare('SELECT * FROM profiles ORDER BY rowid').all() as unknown as ProfileRow[])
      .map(row => this.profileFromRow(row))
  }

  getProfile(id: string): StoredProfile | undefined {
    const row = this.db.prepare('SELECT * FROM profiles WHERE id = ?').get(id) as unknown as ProfileRow | undefined
    return row && this.profileFromRow(row)
  }

  saveProfile(profile: StoredProfile): void {
    this.db.prepare(`
      INSERT INTO profiles (
        id, name, protocol, base_url, model, sealed_secrets, has_api_key, has_custom_headers,
        tests, revision, max_output_tokens, models
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      ON CONFLICT(id) DO UPDATE SET
        name = excluded.name, protocol = excluded.protocol, base_url = excluded.base_url,
        model = excluded.model, sealed_secrets = excluded.sealed_secrets,
        has_api_key = excluded.has_api_key, has_custom_headers = excluded.has_custom_headers,
        tests = excluded.tests, revision = excluded.revision,
        max_output_tokens = excluded.max_output_tokens, models = excluded.models
    `).run(profile.id, profile.name, profile.protocol, profile.baseUrl, profile.model,
      profile.sealedSecrets, Number(profile.hasApiKey), Number(profile.hasCustomHeaders),
      '{}', profile.revision, profile.maxOutputTokens, JSON.stringify(profile.models))
  }

  deleteProfile(id: string): void {
    this.db.exec('BEGIN IMMEDIATE')
    try {
      this.db.prepare('DELETE FROM profiles WHERE id = ?').run(id)
      const settings = this.getSettings()
      if (settings.activeProfileId === id) this.setSettings({ ...settings, activeProfileId: null })
      this.db.exec('COMMIT')
    } catch (error) {
      this.db.exec('ROLLBACK')
      throw error
    }
  }

  listMcpServices(): StoredMcpService[] {
    return (this.db.prepare('SELECT * FROM mcp_services WHERE config IS NOT NULL ORDER BY rowid').all() as unknown as McpServiceRow[])
      .map(row => ({ config: JSON.parse(row.config) as McpServiceConfig, sealedSecrets: row.sealed_secrets }))
  }

  getMcpService(id: string): StoredMcpService | undefined {
    const row = this.db.prepare('SELECT * FROM mcp_services WHERE id = ? AND config IS NOT NULL').get(id) as unknown as McpServiceRow | undefined
    return row && { config: JSON.parse(row.config) as McpServiceConfig, sealedSecrets: row.sealed_secrets }
  }

  saveMcpService(service: StoredMcpService, expectedRevision?: number): boolean {
    const { config, sealedSecrets } = service
    if (expectedRevision === undefined) {
      return this.db.prepare('INSERT INTO mcp_services (id, revision, config, sealed_secrets) VALUES (?, ?, ?, ?) ON CONFLICT(id) DO NOTHING')
        .run(config.id, config.revision, JSON.stringify(config), sealedSecrets).changes === 1
    }
    return this.db.prepare(`UPDATE mcp_services SET revision = ?, config = ?, sealed_secrets = ?, test_result = NULL
      WHERE id = ? AND revision = ? AND config IS NOT NULL`)
      .run(config.revision, JSON.stringify(config), sealedSecrets, config.id, expectedRevision).changes === 1
  }

  removeMcpService(id: string): number | undefined {
    const row = this.db.prepare(`UPDATE mcp_services SET revision = revision + 1, config = NULL,
      sealed_secrets = NULL, test_result = NULL WHERE id = ? AND config IS NOT NULL RETURNING revision`)
      .get(id) as { revision: number } | undefined
    return row?.revision
  }

  recordMcpTest(id: string, expectedRevision: number, result: ConnectionTestResult): boolean {
    return this.db.prepare(`UPDATE mcp_services SET test_result = ? WHERE id = ? AND revision = ?
      AND config IS NOT NULL AND json_extract(config, '$.enabled') = 1`)
      .run(JSON.stringify(result), id, expectedRevision).changes === 1
  }

  getMcpTest(id: string, expectedRevision: number): ConnectionTestResult | undefined {
    const row = this.db.prepare(`SELECT test_result FROM mcp_services WHERE id = ? AND revision = ?
      AND config IS NOT NULL AND json_extract(config, '$.enabled') = 1`).get(id, expectedRevision) as { test_result: string | null } | undefined
    return row?.test_result ? JSON.parse(row.test_result) as ConnectionTestResult : undefined
  }

  createConversation(): ConversationSummary {
    const id = randomUUID()
    const now = new Date().toISOString()
    this.db.prepare('INSERT INTO conversations (id, title, created_at, updated_at) VALUES (?, ?, ?, ?)')
      .run(id, '新的对话', now, now)
    return { id, title: '新的对话', createdAt: now, updatedAt: now, lastMessage: '', titleCustom: false }
  }

  hasConversation(id: string): boolean {
    return !!this.db.prepare('SELECT id FROM conversations WHERE id = ? AND deleted_at IS NULL').get(id)
  }

  listConversations(): ConversationSummary[] {
    return this.conversationRows('c.deleted_at IS NULL', 'c.updated_at DESC, c.rowid DESC')
      .map(row => this.summaryFromRow(row))
  }

  listTrashedConversations(): TrashedConversation[] {
    return this.conversationRows('c.deleted_at IS NOT NULL', 'c.deleted_at DESC, c.rowid DESC')
      .map(row => ({ ...this.summaryFromRow(row), deletedAt: row.deleted_at! }))
  }

  renameConversation(id: string, title: string): ConversationSummary {
    const clean = title.trim()
    if (!clean) throw new Error('请输入对话标题。')
    if (Array.from(clean).length > 80) throw new Error('对话标题最多 80 个字符。')
    const result = this.db.prepare('UPDATE conversations SET title = ?, title_custom = 1 WHERE id = ? AND deleted_at IS NULL')
      .run(clean, id)
    if (!result.changes) throw new Error('该对话已经不存在。')
    return this.summaryFromRow(this.conversationRows('c.id = ?', 'c.rowid', id)[0])
  }

  trashConversation(id: string): void {
    const result = this.db.prepare('UPDATE conversations SET deleted_at = ? WHERE id = ? AND deleted_at IS NULL')
      .run(new Date().toISOString(), id)
    if (!result.changes) throw new Error('该对话已经不存在。')
  }

  restoreConversation(id: string): ConversationSummary {
    const result = this.db.prepare('UPDATE conversations SET deleted_at = NULL WHERE id = ? AND deleted_at IS NOT NULL')
      .run(id)
    if (!result.changes) throw new Error('该对话不在回收站中。')
    return this.summaryFromRow(this.conversationRows('c.id = ?', 'c.rowid', id)[0])
  }

  purgeConversation(id: string): void {
    this.purgeConversations([id])
  }

  purgeConversations(ids: string[]): void {
    if (ids.length === 0) return
    const artifacts = ids.flatMap(id => this.listArtifactOwners(id).map(owner => owner.id))
    const documents = ids.flatMap(id => this.documentIds(id))
    this.db.exec('BEGIN IMMEDIATE')
    try {
      for (const id of ids) {
        if (!this.db.prepare('SELECT id FROM conversations WHERE id = ? AND deleted_at IS NOT NULL').get(id)) {
          throw new Error('只能永久删除回收站中的对话。')
        }
      }
      // File deletion is not transactional. A later SQL rollback can leave missing
      // files, but never loses ownership of files that failed removal.
      this.removeDocumentFiles(documents, true)
      this.removeArtifactFiles(artifacts, true)
      for (const id of ids) {
        this.db.prepare('DELETE FROM messages WHERE conversation_id = ?').run(id)
        this.db.prepare('DELETE FROM conversations WHERE id = ?').run(id)
      }
      this.db.exec('COMMIT')
    } catch (error) {
      this.db.exec('ROLLBACK')
      throw error
    }
  }

  private conversationRows(where: string, order: string, ...params: string[]): ConversationRow[] {
    return this.db.prepare(`
      SELECT c.*, COALESCE((
        SELECT content FROM messages WHERE conversation_id = c.id ORDER BY rowid DESC LIMIT 1
      ), '') AS last_message FROM conversations c WHERE ${where} ORDER BY ${order}
    `).all(...params) as unknown as ConversationRow[]
  }

  private summaryFromRow(row: ConversationRow): ConversationSummary {
    return {
      id: row.id, title: row.title, createdAt: row.created_at, updatedAt: row.updated_at,
      lastMessage: row.last_message, titleCustom: !!row.title_custom
    }
  }

  getMessages(conversationId: string): ChatMessage[] {
    const rows = this.db.prepare('SELECT * FROM messages WHERE conversation_id = ? ORDER BY rowid')
      .all(conversationId) as unknown as MessageRow[]
    return rows.map(row => ({
      id: row.id, conversationId: row.conversation_id, role: row.role, content: row.content,
      status: row.status, createdAt: row.created_at,
      ...(row.profile_id ? { profileId: row.profile_id } : {}),
      ...(row.model ? { model: row.model } : {}),
      ...(row.error ? { error: row.error } : {}),
      ...(row.files ? { files: JSON.parse(row.files) as FileReference[] } : {}),
      ...(row.file_sources ? { fileSources: JSON.parse(row.file_sources) as FileSources } : {}),
      ...(row.attachments ? { attachments: JSON.parse(row.attachments) } : {}),
      ...(row.tool_calls ? { toolCalls: (JSON.parse(row.tool_calls) as ToolCallRecord[]).map(call => call.runId ? this.listToolCalls(call.runId).find(saved => saved.id === call.id) ?? call : call) } : {})
    }))
  }

  addMessage(message: ChatMessage): void {
    this.addMessages([message])
  }

  addMessages(messages: ChatMessage[]): void {
    this.db.exec('BEGIN IMMEDIATE')
    try {
      for (const message of messages) {
        this.db.prepare('INSERT INTO messages (id, conversation_id, role, content, status, created_at, profile_id, model, error, attachments, tool_calls, files, file_sources) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)')
          .run(message.id, message.conversationId, message.role, message.content, message.status,
            message.createdAt, message.profileId ?? null, message.model ?? null, message.error ?? null,
            message.attachments ? JSON.stringify(message.attachments) : null,
            message.toolCalls?.length ? JSON.stringify(message.toolCalls) : null,
            message.files ? JSON.stringify(message.files) : null, message.fileSources ? JSON.stringify(message.fileSources) : null)
        const first = this.db.prepare(`
          SELECT COUNT(*) AS count FROM messages WHERE conversation_id = ? AND role = 'user'
        `).get(message.conversationId) as { count: number }
        if (message.role === 'user' && first.count === 1) {
          const title = message.content.replace(/\s+/g, ' ').trim().slice(0, 24)
          this.db.prepare('UPDATE conversations SET title = ? WHERE id = ? AND title_custom = 0')
            .run(title, message.conversationId)
        }
        this.touchConversation(message.conversationId)
      }
      this.db.exec('COMMIT')
    } catch (error) {
      this.db.exec('ROLLBACK')
      throw error
    }
  }

  updateMessage(message: ChatMessage): void {
    const result = this.db.prepare(`
      UPDATE messages SET content = ?, status = ?, profile_id = ?, model = ?, error = ?, tool_calls = ?, file_sources = ?
      WHERE id = ? AND conversation_id = ?
    `).run(message.content, message.status, message.profileId ?? null, message.model ?? null,
      message.error ?? null, message.toolCalls?.length ? JSON.stringify(message.toolCalls) : null,
      message.fileSources ? JSON.stringify(message.fileSources) : null, message.id, message.conversationId)
    if (!result.changes) throw new Error('消息已经不存在。')
    this.touchConversation(message.conversationId)
  }

  saveTaskRun(run: TaskRun): void {
    this.db.prepare(`
      INSERT INTO task_runs (id, request_id, conversation_id, assistant_message_id, status, provider_id, model, tool_calls_count, active_ms, continuation_of, tool_revisions)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      ON CONFLICT(id) DO UPDATE SET status = excluded.status,
        tool_calls_count = excluded.tool_calls_count, active_ms = excluded.active_ms
    `).run(run.id, run.requestId, run.conversationId, run.assistantMessageId, run.status,
      run.providerId, run.model, run.toolCallsCount, run.activeMs, run.continuationOf ?? null, run.toolRevisions ? JSON.stringify(run.toolRevisions) : null)
  }

  getTaskRun(id: string): TaskRun | null {
    const row = this.db.prepare(`SELECT id, request_id AS requestId, conversation_id AS conversationId,
      assistant_message_id AS assistantMessageId, status, provider_id AS providerId, model,
      tool_calls_count AS toolCallsCount, active_ms AS activeMs, continuation_of AS continuationOf, tool_revisions AS toolRevisions FROM task_runs WHERE id = ?`).get(id)
    if (!row) return null
    const { continuationOf, toolRevisions, ...base } = row
    return { ...base, ...(continuationOf ? { continuationOf } : {}), ...(toolRevisions ? { toolRevisions: JSON.parse(toolRevisions as string) } : {}) } as unknown as TaskRun
  }

  getLatestTaskRun(conversationId: string): TaskRun | null {
    const row = this.db.prepare('SELECT id FROM task_runs WHERE conversation_id = ? ORDER BY rowid DESC LIMIT 1').get(conversationId)
    return row ? this.getTaskRun(row.id as string) : null
  }

  hasTaskRequest(requestId: string): boolean {
    return !!this.db.prepare('SELECT id FROM task_runs WHERE request_id = ?').get(requestId)
  }

  getUnknownToolTargets(conversationId: string): string[] {
    const rows = this.db.prepare(`SELECT calls.assessment FROM tool_executions AS calls
      JOIN task_runs AS runs ON runs.id = calls.run_id
      WHERE runs.conversation_id = ? AND calls.status = 'unknown'
      AND NOT EXISTS (SELECT 1 FROM tool_resolutions AS resolutions WHERE resolutions.run_id = calls.run_id AND resolutions.call_id = calls.id)`).all(conversationId)
    return [...new Set(rows.map(row => {
      const assessment = row.assessment ? JSON.parse(row.assessment as string) as ToolCallRecord['assessment'] : undefined
      return assessment?.target || '*'
    }))]
  }

  getResolvedToolTargets(conversationId: string): string[] {
    const rows = this.db.prepare(`SELECT calls.assessment FROM tool_executions AS calls
      JOIN task_runs AS runs ON runs.id = calls.run_id
      JOIN tool_resolutions AS r ON r.run_id = calls.run_id AND r.call_id = calls.id
      WHERE runs.conversation_id = ?`).all(conversationId)
    return [...new Set(rows.map(row => row.assessment ? JSON.parse(row.assessment as string).target || '*' : '*'))] as string[]
  }

  listUnresolvedToolCalls(conversationId: string): UnknownToolCall[] {
    const rows = this.db.prepare(`SELECT calls.* FROM tool_executions AS calls
      JOIN task_runs AS runs ON runs.id = calls.run_id
      WHERE runs.conversation_id = ? AND calls.status = 'unknown'
      AND NOT EXISTS (SELECT 1 FROM tool_resolutions AS r WHERE r.run_id = calls.run_id AND r.call_id = calls.id)
      ORDER BY calls.rowid`).all(conversationId)
    return rows.map(row => ({ runId: row.run_id as string, callId: row.id as string,
      revision: createHash('sha256').update(JSON.stringify(row)).digest('hex'),
      summary: row.assessment ? JSON.parse(row.assessment as string).summary : '历史未知动作',
      ...(row.dispatch_phase ? { dispatchPhase: row.dispatch_phase as ToolCallRecord['dispatchPhase'] } : {}) }))
  }

  resolveUnknownToolCall(input: ResolveUnknownToolCallInput): void {
    if (!['handled', 'abandoned'].includes(input.decision) || !this.hasConversation(input.conversationId)) throw new Error('未知动作处理参数不正确。')
    const current = this.listUnresolvedToolCalls(input.conversationId).find(call => call.runId === input.runId && call.callId === input.callId && call.revision === input.revision)
    if (!current) throw new Error('未知动作记录已变化或已经处理，请刷新。')
    this.db.prepare('INSERT INTO tool_resolutions (run_id, call_id, revision, decision, resolved_at) VALUES (?, ?, ?, ?, ?)')
      .run(input.runId, input.callId, input.revision, input.decision, new Date().toISOString())
  }

  saveToolCall(record: ToolCallRecord): void {
    if (!record.runId || !record.status) throw new Error('工具执行记录缺少任务或状态。')
    this.db.prepare(`
      INSERT INTO tool_executions (run_id, id, name, arguments, result, status, started_at, finished_at, assessment, dispatch_phase)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      ON CONFLICT(run_id, id) DO UPDATE SET result = excluded.result, status = excluded.status,
        started_at = excluded.started_at, finished_at = excluded.finished_at, assessment = excluded.assessment, dispatch_phase = excluded.dispatch_phase
    `).run(record.runId, record.id, record.name, JSON.stringify(record.arguments),
      record.result === undefined ? null : JSON.stringify(record.result), record.status,
      record.startedAt ?? null, record.finishedAt ?? null, record.assessment ? JSON.stringify(record.assessment) : null, record.dispatchPhase ?? null)
  }

  listToolCalls(runId: string): ToolCallRecord[] {
    const rows = this.db.prepare('SELECT calls.*, r.decision, r.resolved_at FROM tool_executions AS calls LEFT JOIN tool_resolutions AS r ON r.run_id = calls.run_id AND r.call_id = calls.id WHERE calls.run_id = ? ORDER BY calls.rowid').all(runId)
    return rows.map(row => ({
      id: row.id as string, runId: row.run_id as string, name: row.name as string,
      arguments: JSON.parse(row.arguments as string), status: row.status as ToolCallRecord['status'],
      ...(row.result !== null ? { result: JSON.parse(row.result as string) } : {}),
      ...(row.started_at !== null ? { startedAt: row.started_at as string } : {}),
      ...(row.finished_at !== null ? { finishedAt: row.finished_at as string } : {}),
      ...(row.dispatch_phase ? { dispatchPhase: row.dispatch_phase as ToolCallRecord['dispatchPhase'] } : {}),
      ...(row.decision ? { resolution: { decision: row.decision as 'handled' | 'abandoned', resolvedAt: row.resolved_at as string } } : {}),
      ...(row.assessment !== null ? { assessment: JSON.parse(row.assessment as string) } : {})
    }))
  }

  beginArtifactFiles(id: string, conversationId: string): void {
    if (!/^[a-f0-9-]{36}$/.test(id) || !this.hasConversation(conversationId)) throw new Error('图片所属对话已失效。')
    this.db.prepare('INSERT INTO artifact_owners(id, conversation_id) VALUES (?, ?)').run(id, conversationId)
  }

  listArtifactOwners(conversationId: string): { id: string; published: number }[] {
    return this.db.prepare('SELECT id, published FROM artifact_owners WHERE conversation_id = ?').all(conversationId) as { id: string; published: number }[]
  }

  forgetArtifactFiles(id: string): void { this.db.prepare('DELETE FROM artifact_owners WHERE id = ?').run(id) }

  private recoverArtifactFiles(): void {
    // One pass over explicit owners only; anonymous pre-migration residues cannot be assigned safely.
    const owners = this.db.prepare('SELECT id FROM artifact_owners WHERE published = 0 OR conversation_id NOT IN (SELECT id FROM conversations)').all() as { id: string }[]
    for (const owner of owners) {
      try { this.removeArtifactFiles([owner.id]) }
      catch { this.artifactCleanupWarning = ARTIFACT_CLEANUP_ERROR }
    }
  }

  saveArtifact(reference: ArtifactReference): void {
    if (!this.hasConversation(reference.conversationId) || !this.db.prepare('SELECT id FROM artifact_owners WHERE id = ? AND conversation_id = ? AND published = 0').get(reference.id, reference.conversationId)) throw new Error('图片清理记录已失效。')
    this.db.exec('BEGIN IMMEDIATE')
    try {
      this.db.prepare(`INSERT INTO tool_artifacts (id, conversation_id, mime_type, byte_length, source_file_id)
        VALUES (?, ?, ?, ?, ?)`).run(reference.id, reference.conversationId, reference.mimeType,
        reference.byteLength, reference.sourceFileId ?? null)
      this.db.prepare('UPDATE artifact_owners SET published = 1 WHERE id = ?').run(reference.id)
      this.db.exec('COMMIT')
    } catch (error) { this.db.exec('ROLLBACK'); throw error }
  }

  getArtifact(id: string): ArtifactReference | null {
    const row = this.db.prepare(`SELECT id, conversation_id AS conversationId, mime_type AS mimeType,
      byte_length AS byteLength, source_file_id AS sourceFileId FROM tool_artifacts WHERE id = ?`).get(id)
    if (!row) return null
    const { sourceFileId, ...reference } = row
    return { ...reference, ...(sourceFileId !== null ? { sourceFileId } : {}) } as unknown as ArtifactReference
  }

  private removeArtifactFiles(ids: string[], preserveUnpublished = false): void {
    for (const id of ids) {
      if (!this.artifactDirectory || !/^[a-f0-9-]{36}$/.test(id)) throw new Error(ARTIFACT_CLEANUP_ERROR)
      try { unlinkSync(join(this.artifactDirectory, id)) }
      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw new Error(ARTIFACT_CLEANUP_ERROR) }
      // A previously admitted write may still create bytes after purge has committed.
      if (!preserveUnpublished || this.db.prepare('SELECT published FROM artifact_owners WHERE id = ?').get(id)?.published === 1) this.forgetArtifactFiles(id)
    }
  }

  private touchConversation(id: string): void {
    this.db.prepare('UPDATE conversations SET updated_at = ? WHERE id = ?').run(new Date().toISOString(), id)
  }

  private profileFromRow(row: ProfileRow): StoredProfile {
    return {
      id: row.id, name: row.name, protocol: row.protocol, baseUrl: row.base_url, model: row.model,
      sealedSecrets: row.sealed_secrets, hasApiKey: !!row.has_api_key,
      hasCustomHeaders: !!row.has_custom_headers, maxOutputTokens: row.max_output_tokens,
      models: (JSON.parse(row.models!) as ServiceModel[]).map(model => ({ ...model, tests: { ...untestedConnections(), ...model.tests } })), revision: row.revision
    }
  }
}
